# Resend settings for email delivery
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Growthify Contact <onboarding@resend.dev>"
CONTACT_TO_EMAIL=your@recipient.email

# MongoDB configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/growthify?retryWrites=true&w=majority

# App settings
PORT=5000
JWT_SECRET=your-jwt-secret-key-min-32-characters

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here

# When deploying to Render, add these environment variables to your Render service.
# Render provides the PORT automatically so you can omit it or keep as fallback.

# AWS Lambda (optional for local testing)
AWS_REGION=ap-south-1
